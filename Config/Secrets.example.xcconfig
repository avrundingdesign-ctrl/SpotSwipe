// Kopieren nach Config/Secrets.xcconfig und ausfüllen. Die Datei steht in .gitignore.
SPOTSWIPE_BUNDLE_ID = de.deinefirma.spotswipe
SPOTSWIPE_TEAM_ID = ABCDE12345

// Google Cloud: Places API (New) aktivieren, Key auf iOS-Apps (Bundle-ID oben)
// und auf "Places API (New)" beschränken.
GOOGLE_PLACES_API_KEY = dein-api-key

// iCloud-Sync einschalten (nur mit Team-ID):
// SPOTSWIPE_CLOUDKIT = YES
// SPOTSWIPE_ENTITLEMENTS = SpotSwipe/SpotSwipe.entitlements
