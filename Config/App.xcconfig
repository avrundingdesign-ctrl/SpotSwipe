// Standardwerte. Eigene Werte gehören in Config/Secrets.xcconfig (nicht eingecheckt).
// Die App braucht keinen API-Key: Fotos und Bewertungen kommen über den Meanwhile-Proxy.
SPOTSWIPE_BUNDLE_ID = com.avrundingdesign.spotswipe
SPOTSWIPE_TEAM_ID = 8698DN5A64

// Bibliothek per iCloud synchronisieren (CloudKit-Container iCloud.<Bundle-ID>).
SPOTSWIPE_CLOUDKIT = YES

#include? "Secrets.xcconfig"
