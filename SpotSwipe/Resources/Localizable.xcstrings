    "Die Suche dauert dadurch etwas länger, die Treffer passen aber besser." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching takes a little longer, but the results fit better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda tarda un poco más, pero los resultados encajan mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche prend un peu plus de temps, mais les résultats correspondent mieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca richiede un po’ più di tempo, ma i risultati sono più pertinenti."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama biraz daha uzun sürer ama sonuçlar daha iyi eşleşir."
          }
        }
      }
    },
    "Diesmal war nichts dabei. Probier einen anderen Begriff oder einen größeren Umkreis." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing for you this time. Try another term or a bigger radius."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vez no había nada. Prueba otra palabra o un radio mayor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien cette fois. Essaie un autre mot ou un rayon plus grand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavolta niente. Prova un’altra parola o un raggio più ampio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sefer bir şey çıkmadı. Başka bir kelime ya da daha geniş bir mesafe dene."
          }
        }
      }
    },
