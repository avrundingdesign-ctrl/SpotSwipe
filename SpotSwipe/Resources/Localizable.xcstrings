        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puanlar, çalışma saatleri ve fotoğraflar: Google Haritalar. Fotoğraflar belirtilen sahiplerine aittir."
          }
        }
      }
    },
