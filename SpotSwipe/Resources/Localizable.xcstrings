        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios guardados van a tu biblioteca, con ruta, web y teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les spots gardés arrivent dans ta bibliothèque – avec itinéraire, site web et numéro."
          }
        },
