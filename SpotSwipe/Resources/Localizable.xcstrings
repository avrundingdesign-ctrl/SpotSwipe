    "Gemerkte Orte speichert Swipez auf deinem Gerät und – wenn eingeschaltet – in deiner privaten iCloud. Es gibt kein Tracking und keine Werbung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipez stores saved places on your device and – if turned on – in your private iCloud. No tracking, no ads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipez guarda los sitios en tu dispositivo y, si lo activas, en tu iCloud privado. Sin rastreo ni anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipez enregistre les lieux gardés sur ton appareil et – si activé – dans ton iCloud privé. Ni pistage ni publicité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipez salva i posti sul tuo dispositivo e, se attivato, nel tuo iCloud privato. Nessun tracciamento, nessuna pubblicità."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipez kaydedilen mekânları cihazında ve – açıksa – özel iCloud’unda saklar. Takip yok, reklam yok."
          }
        }
      }
    },
    "Gemerkte Spots landen in deiner Bibliothek – mit Route, Website und Telefonnummer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
