    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotSwipe nutzt deinen Standort, um Orte in deiner Nähe zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotSwipe uses your location to find places near you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotSwipe usa tu ubicación para encontrar sitios cerca de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotSwipe utilise ta position pour trouver des lieux près de toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotSwipe usa la tua posizione per trovare posti vicino a te."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotSwipe yakınındaki mekânları bulmak için konumunu kullanır."
          }
